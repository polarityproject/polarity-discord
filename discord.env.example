# The rooms Discord bot's settings (compose.yaml): copy to
# discord.env in this folder. The webhook URL itself is the secret
# secrets/discord_webhook, not here.
#
# The rooms API's address, without a path (empty: the public Worker,
# https://sfvr-rooms-api.<account>.workers.dev).
ROOMS_API_URL=
# How often it reads the list (seconds; at least 10, the API's cache), and the
# longest it goes without an edit while nothing changes (its "last checked"
# time, which shows the bot is alive).
POLL_EVERY=20
REFRESH_EVERY=300
# How long the API may fail before the message says it cannot be reached
# (seconds; until then it keeps the last list).
FAIL_AFTER=120
# The message's heading, the most rooms shown (up to 9, Discord's 10 embeds
# less the heading), and the SFVR versions listed (comma-separated, empty:
# every version).
HEADING=SFVR public rooms
MAX_ROOMS=9
ROOM_VERSIONS=
# When a public room opens: post this notice, then delete it after
# NEW_ROOM_DELETE_AFTER seconds (it leaves the channel unread); at most one
# every NEW_ROOM_COOLDOWN seconds. NEW_ROOM_NOTICE=0: no notices.
NEW_ROOM_NOTICE=1
NEW_ROOM_TEXT=New room opened
NEW_ROOM_DELETE_AFTER=5
NEW_ROOM_COOLDOWN=60
# Adopt a message this webhook already posted (its id) instead of the saved
# one; empty normally.
MESSAGE_ID=
# 1: on stopping, edit the message to say it is not updating.
OFFLINE_NOTICE=1
